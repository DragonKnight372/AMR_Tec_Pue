// ====Librerias Ocupadad====
#include <SPI.h>
#include <mcp_can.h>
#include "sbus.h" //Esta libreria es propia para el control, sin el no funciona

// ===== SBUS =====
bfs::SbusRx sbus_rx(&Serial2, 16, 17, true, false); // Pines para la esp32
bfs::SbusData data;

// ===== MCP2515 =====
#define CAN_CS   5
#define CAN_SCK  18
#define CAN_MISO 19
#define CAN_MOSI 23
MCP_CAN CAN0(CAN_CS);
#define ID_PARO_EMERGENCIA 0x210  // ID del mensaje CAN para el paro

// ===== Variables =====
int valorVel = 0;
int valorFreno = 0;
int valorDirCoche = 0;
int reversa01 = 0;

float velActual = 0;          // velocidad actual (rampa)
float velObjetivo = 0;        // velocidad objetivo
const float velStep = 3;      // incremento/decremento por ciclo

// ===== SBUS Config =====
const int SBUS_MIN = 172;
const int SBUS_MID = 992;
const int SBUS_MAX = 1811;

// ===== Deadbands =====
const int DEADBAND_CH0 = 20;        // velocidad/freno
const int DEADBAND_DIR = 30;        // dirección (zona muerta en joystick)
const int DEADBAND_VEL = 30;   // zona muerta adicional para velocidad (Preferible para que no este mandando muchos mensajes al CAN)
const int DEADZONE_FRENO = 3;       // zona muerta para Frenos (ecita que se sobre esfuerce debido al joysitck)
const int DEADZONE_DIR_ENVIO = 2;   // zona muerta para dirección (evita los brincos que da por el control)
const int CENTRO_DIR = 50;

// ===== CAN =====
int lastVel = -1;
int lastDir = -1;
int lastFreno = -1;
int lastReversa = -1;

// ==== Comunicación CAN por Serial (añadido) ====
String serialInput = "";
bool modoSerial = false;  // false = SBUS activo, true = control desde Serial


// ===== Control de tiempo =====
unsigned long previousMillis = 0;
const unsigned long interval = 20; // 50 Hz

void setup() {
  sbus_rx.Begin();
  SPI.begin(CAN_SCK, CAN_MISO, CAN_MOSI, CAN_CS);

  if (CAN0.begin(MCP_ANY, CAN_500KBPS, MCP_8MHZ) == CAN_OK)
    CAN0.setMode(MCP_NORMAL);
  else
    while (1) delay(1000);

  Serial.begin(115200);
  Serial.println("Sistema iniciado correctamente");
  Serial.println("Modo dual CAN listo (SBUS + Serial)");
}

void loop() {
  unsigned long currentMillis = millis();
  if (currentMillis - previousMillis < interval) return;
  previousMillis = currentMillis;

  /// ===== Lectura del SBUS =====
  bool sbusOk = sbus_rx.Read();
  if (!sbusOk) return;
  data = sbus_rx.data();

  // ===== CH4: PARO + RELÉ EN EL MISMO CANAL =====
  int ch4 = data.ch[4];   // canal que controla paro + relé

  // Palanca arriba  = modo RUN (sin paro, relé ON)
  // Palanca abajo   = modo SAFE (paro activo, relé OFF)
  bool modoRun      = (ch4 >= SBUS_MID);   // arriba = true
  bool paroActivado = !modoRun;           // paro = lo contrario

  // ---- Mensaje de PARO (0x210) ----
  byte dataParo[1] = { (byte)(paroActivado ? 1 : 0) };
  CAN0.sendMsgBuf(ID_PARO_EMERGENCIA, 0, 1, dataParo);

  // ---- Mensaje de RELÉ (0x310) ----
  // Solo ON cuando NO hay paro
  byte dataRele[1] = { (byte)(modoRun ? 1 : 0) };
  CAN0.sendMsgBuf(0x310, 0, 1, dataRele);

  // ===== SELECCIÓN DE MODO CON CH5 =====
  int ch5 = data.ch[5]; // canal selector de modo SERIAL/SBUS
  if (ch5 < SBUS_MID) {
    if (!modoSerial) {
      Serial.println("Cambiando a modo SERIAL");
      modoSerial = true;
    }
  } else {
    if (modoSerial) {
      Serial.println("Cambiando a modo SBUS");
      modoSerial = false;
    }
  }

  // ===== EJECUCIÓN SEGÚN MODO =====
  if (modoSerial) {
    // MODO SERIAL: leer comandos por puerto serial
    if (Serial.available()) {
      String input = Serial.readStringUntil('\n');
      input.trim();
      if (input.length() > 0) {
        enviarMensajeCAN(input);
      }
    }
    return; // no ejecutar el control SBUS
  }

  // ===== CONTROL SBUS NORMAL =====
  int ch0 = data.ch[0]; // velocidad + freno
  int ch1 = data.ch[1]; // dirección
  int ch3 = data.ch[3]; // reversa

  // ===== CH6: MODO LENTO / RÁPIDO =====
  int ch6 = data.ch[6];                 
  bool modoLento = (ch6 < SBUS_MID);    
  float maxVelocidad = modoLento ? 70.0 : 100.0;

  // ===== CH0: VELOCIDAD + FRENO =====
  if (!paroActivado) {
    if (abs(ch0 - SBUS_MID) <= DEADBAND_VEL) {
      velObjetivo = 0;
    } 
    else if (ch0 > SBUS_MID + DEADBAND_VEL) {

      long raw = map(ch0, SBUS_MID + DEADBAND_VEL, SBUS_MAX, 0, 100);
      raw = constrain(raw, 0, 100);

      float v = raw / 100.0;   // 0.0 – 1.0
      v = v * v;               // curva suave
      velObjetivo = v * maxVelocidad;   // <<<<<<<< CORREGIDO
    }
    else {
      velObjetivo = 0;
    }
  }

  // ===== Rampa de velocidad =====
  float step = velStep;
  if (velObjetivo < 20) step = 1.0;

  if (velActual < velObjetivo) {
      velActual += step;
      if (velActual > velObjetivo) velActual = velObjetivo;
  } else if (velActual > velObjetivo) {
      velActual -= step;
      if (velActual < velObjetivo) velActual = velObjetivo;
  }

  valorVel = (int)velActual;

  // ===== FRENO =====
  int frenoObjetivo = 0;
  if (ch0 < SBUS_MID - DEADBAND_CH0) {
      frenoObjetivo = map(ch0, SBUS_MID - DEADBAND_CH0, SBUS_MIN, 0, 179);
      frenoObjetivo = constrain(frenoObjetivo, 0, 179);
  }
  valorFreno = frenoObjetivo;

  // ===== DIRECCIÓN =====
  if (abs(ch1 - SBUS_MID) <= DEADBAND_DIR) {
      valorDirCoche = CENTRO_DIR;
  } 
  else if (ch1 > SBUS_MID + DEADBAND_DIR) {
      valorDirCoche = map(ch1, SBUS_MID + DEADBAND_DIR, SBUS_MAX, CENTRO_DIR, 100);
  } 
  else if (ch1 < SBUS_MID - DEADBAND_DIR) {
      valorDirCoche = map(ch1, SBUS_MIN, SBUS_MID - DEADBAND_DIR, 0, CENTRO_DIR);
  }

  // ===== REVERSA =====
  // Usamos ch3 para fijar reversa01 y luego sólo mandamos si cambia
  if (ch3 > SBUS_MID) {
      reversa01 = 0;   // reversa
  } else {
      reversa01 = 1;   // adelante
  }

  // ===== ENVÍO CAN =====
  int frenoEnviar = 179 - valorFreno;

  if (abs(frenoEnviar - lastFreno) > DEADZONE_FRENO) {
      byte dataFreno[1] = { (byte)frenoEnviar };
      CAN0.sendMsgBuf(0x200, 0, 1, dataFreno);
      lastFreno = frenoEnviar;
  }

  if (abs(valorVel - lastVel) > 0) {
      byte dataVel[1] = { (byte)valorVel };
      CAN0.sendMsgBuf(0x300, 0, 1, dataVel);
      lastVel = valorVel;
  }

  if (reversa01 != lastReversa) {
      byte dataDirTM[1] = { (byte)reversa01 };
      CAN0.sendMsgBuf(0x320, 0, 1, dataDirTM);
      lastReversa = reversa01;
  }

  if (abs(valorDirCoche - lastDir) > DEADZONE_DIR_ENVIO) {
      byte dataDirC[1] = { (byte)valorDirCoche };
      CAN0.sendMsgBuf(0x100, 0, 1, dataDirC);
      lastDir = valorDirCoche;
  }
}


// ===== FUNCIÓN: enviar mensaje CAN directo (desde Serial) =====
void enviarMensajeCAN(String s) {
  int spaceIndex = s.indexOf(' ');
  if (spaceIndex == -1) {
    Serial.println("Formato incorrecto. Usa: ID valor (Ej: 200 75)");
    return;
  }

  String idStr = s.substring(0, spaceIndex);
  String valStr = s.substring(spaceIndex + 1);
  idStr.trim();
  valStr.trim();

  unsigned long txId = strtoul(idStr.c_str(), NULL, 16);
  int valor = valStr.toInt();

  if (valor < 0) valor = 0;
  if (valor > 100) valor = 100;

  byte data[1];
  data[0] = (byte)valor;

  byte sndStat = CAN0.sendMsgBuf(txId, 0, 1, data);

  if (sndStat == CAN_OK) {
    Serial.print("[TX OK] ID:0x");
    Serial.print(txId, HEX);
    Serial.print(" Valor: ");
    Serial.println(valor);
  } else {
    Serial.println("[TX FAIL]");
  }
}
